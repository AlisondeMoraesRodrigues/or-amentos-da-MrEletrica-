# ---------------------------------------------------------------------------
# MR ORÇAMENTOS - Variáveis de ambiente
# Copie este arquivo para ".env" e preencha com os valores do seu projeto.
# Passo a passo completo: SETUP_SUPABASE.md
# NUNCA faça commit do arquivo .env com chaves reais.
# Apenas variáveis com prefixo VITE_ são expostas ao frontend.
# ---------------------------------------------------------------------------

# URL do projeto Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública anônima do Supabase (Project Settings > API > anon public)
# Esta chave é segura para o frontend desde que RLS esteja habilitado nas tabelas.
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# ---------------------------------------------------------------------------
# Integrações futuras (NÃO usar chave privada no frontend).
# Estas serão consumidas por Edge Functions / backend, não pelo Vite.
# ---------------------------------------------------------------------------
# OCR_PROVIDER=none            # none | google-vision | ocrspace | aws-textract
# OCR_API_KEY=
# AI_PROVIDER=none             # none | anthropic | openai
# AI_API_KEY=
